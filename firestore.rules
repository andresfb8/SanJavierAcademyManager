rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────

    // Returns the authenticated user's document from the users collection.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Returns the role of the authenticated user.
    function getRole() {
      return getUserData().role;
    }

    // Returns the clubId of the authenticated user.
    function getClubId() {
      return getUserData().clubId;
    }

    // True when the user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // True when the authenticated user holds the given role.
    function hasRole(role) {
      return isAuthenticated() && getRole() == role;
    }

    // True when the authenticated user holds any of the given roles.
    function hasAnyRole(roles) {
      return isAuthenticated() && getRole() in roles;
    }

    // True when the authenticated user is a director or coordinador.
    function isAdmin() {
      return hasAnyRole(['director', 'coordinador']);
    }

    // True when the resource document belongs to the same club as the user.
    function belongsToClub() {
      return resource.data.clubId == getClubId();
    }

    // True when the incoming document belongs to the same club as the user.
    function incomingBelongsToClub() {
      return request.resource.data.clubId == getClubId();
    }

    // True when the authenticated user's linkedPlayerId matches the given id.
    function isOwnPlayer(playerId) {
      return getUserData().linkedPlayerId == playerId;
    }

    // True when the given playerId is among the tutor's linked children.
    function isChildPlayer(playerId) {
      return playerId in getUserData().linkedPlayerIds;
    }

    // ─── Users Collection ───────────────────────────────────────────────

    match /users/{userId} {
      // Any authenticated user can read their own document.
      // Directors/coordinadores can read all users within their club.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (isAdmin() && resource.data.clubId == getClubId())
      );

      // An authenticated user can create their own document (first login bootstrap).
      // Directors can also create user documents for others in their club.
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        (hasRole('director') && request.resource.data.clubId == getClubId())
      );

      // Only directors can modify/delete user documents, scoped to their club.
      allow update: if hasRole('director') && resource.data.clubId == getClubId() && incomingBelongsToClub();
      allow delete: if hasRole('director') && resource.data.clubId == getClubId();
    }

    // ─── Players Collection ─────────────────────────────────────────────

    match /players/{playerId} {
      // director/coordinador: full CRUD within their club.
      // entrenador: read players within their club.
      // jugador: read own profile only.
      // tutor: read their children's profiles only.
      allow read: if isAuthenticated() && belongsToClub() && (
        isAdmin() ||
        hasRole('entrenador') ||
        (hasRole('jugador') && isOwnPlayer(playerId)) ||
        (hasRole('tutor') && isChildPlayer(playerId))
      );

      allow create: if isAdmin() && incomingBelongsToClub();
      allow update: if isAdmin() && belongsToClub() && incomingBelongsToClub();
      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Groups Collection ──────────────────────────────────────────────

    match /groups/{groupId} {
      // director/coordinador: full CRUD within their club.
      // entrenador: read groups within their club.
      // jugador: read groups within their club (own groups enforced at app level).
      // tutor: read groups within their club (children groups enforced at app level).
      allow read: if isAuthenticated() && belongsToClub() && (
        isAdmin() ||
        hasRole('entrenador') ||
        hasRole('jugador') ||
        hasRole('tutor')
      );

      allow create: if isAdmin() && incomingBelongsToClub();
      allow update: if isAdmin() && belongsToClub() && incomingBelongsToClub();
      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Enrollments Collection ─────────────────────────────────────────

    match /enrollments/{enrollmentId} {
      // director/coordinador: full CRUD within their club.
      // entrenador: read enrollments within their club.
      // jugador: read own enrollments.
      // tutor: read children's enrollments.
      allow read: if isAuthenticated() && belongsToClub() && (
        isAdmin() ||
        hasRole('entrenador') ||
        (hasRole('jugador') && isOwnPlayer(resource.data.playerId)) ||
        (hasRole('tutor') && isChildPlayer(resource.data.playerId))
      );

      allow create: if isAdmin() && incomingBelongsToClub();
      allow update: if isAdmin() && belongsToClub() && incomingBelongsToClub();
      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Attendance Collection ──────────────────────────────────────────

    match /attendance/{attendanceId} {
      // director/coordinador: full access within their club.
      // entrenador: read and write attendance within their club.
      // jugador: read own attendance records.
      // tutor: read children's attendance records.
      allow read: if isAuthenticated() && belongsToClub() && (
        isAdmin() ||
        hasRole('entrenador') ||
        (hasRole('jugador') && isOwnPlayer(resource.data.playerId)) ||
        (hasRole('tutor') && isChildPlayer(resource.data.playerId))
      );

      allow create: if isAuthenticated() && incomingBelongsToClub() && (
        isAdmin() ||
        hasRole('entrenador')
      );

      allow update: if isAuthenticated() && belongsToClub() && incomingBelongsToClub() && (
        isAdmin() ||
        hasRole('entrenador')
      );

      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Payments Collection ────────────────────────────────────────────

    match /payments/{paymentId} {
      // director/coordinador: full access within their club.
      // jugador: read own payments.
      // tutor: read children's payments.
      // entrenador: no access.
      allow read: if isAuthenticated() && belongsToClub() && (
        isAdmin() ||
        (hasRole('jugador') && isOwnPlayer(resource.data.playerId)) ||
        (hasRole('tutor') && isChildPlayer(resource.data.playerId))
      );

      allow create: if isAdmin() && incomingBelongsToClub();
      allow update: if isAdmin() && belongsToClub() && incomingBelongsToClub();
      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Coaches Collection ─────────────────────────────────────────────

    match /coaches/{coachId} {
      // director/coordinador: full CRUD within their club.
      // All other roles: no access.
      allow read: if isAdmin() && belongsToClub();
      allow create: if isAdmin() && incomingBelongsToClub();
      allow update: if isAdmin() && belongsToClub() && incomingBelongsToClub();
      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Settings Collection ────────────────────────────────────────────

    match /settings/{settingId} {
      // director/coordinador: full access within their club.
      // All other roles: no access.
      allow read: if isAdmin() && belongsToClub();
      allow create: if isAdmin() && incomingBelongsToClub();
      allow update: if isAdmin() && belongsToClub() && incomingBelongsToClub();
      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Activities Collection ──────────────────────────────────────────

    match /activities/{activityId} {
      // director/coordinador: full access within their club.
      // entrenador: read activities within their club.
      // jugador/tutor: read activities within their club.
      allow read: if isAuthenticated() && belongsToClub();

      allow create: if isAuthenticated() && incomingBelongsToClub() && (
        isAdmin() ||
        hasRole('entrenador')
      );

      allow update: if isAdmin() && belongsToClub() && incomingBelongsToClub();
      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Invitations Collection ─────────────────────────────────────────
    // Directors can manage invitations.
    // Unauthenticated users can read invitations (needed for activation page).
    // Users can update their own invitation when accepting (status = 'aceptada').

    match /invitations/{invitationId} {
      // Allow unauthenticated read for activation page
      // Allow authenticated admin read within their club
      allow read: if true || (isAuthenticated() && belongsToClub() && isAdmin());

      allow create: if hasRole('director') && incomingBelongsToClub();

      // Allow directors to update invitations in their club
      // Allow users to update their own invitation when accepting
      allow update: if (
        (hasRole('director') && belongsToClub() && incomingBelongsToClub()) ||
        (request.resource.data.status == 'aceptada' &&
         request.resource.data.email == request.auth.token.email)
      );

      allow delete: if hasRole('director') && belongsToClub();
    }

    // ─── Events Collection ──────────────────────────────────────────────
    // director/coordinador: CRUD completo.
    // entrenador: lectura dentro de su club.
    // jugador/tutor: lectura dentro de su club.

    match /events/{eventId} {
      allow read: if isAuthenticated() && belongsToClub();
      allow create: if isAdmin() && incomingBelongsToClub();
      allow update: if isAdmin() && belongsToClub() && incomingBelongsToClub();
      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Event Payments Collection ──────────────────────────────────────
    // director/coordinador: CRUD completo.
    // jugador: lectura de sus propios pagos de evento.
    // tutor: lectura de pagos de eventos de sus hijos.

    match /eventPayments/{paymentId} {
      allow read: if isAuthenticated() && belongsToClub() && (
        isAdmin() ||
        (hasRole('jugador') && isOwnPlayer(resource.data.playerId)) ||
        (hasRole('tutor') && isChildPlayer(resource.data.playerId))
      );
      allow create: if isAdmin() && incomingBelongsToClub();
      allow update: if isAdmin() && belongsToClub() && incomingBelongsToClub();
      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Evaluations Collection ─────────────────────────────────────────
    // director/coordinador: CRUD completo.
    // entrenador: lectura y escritura (crea evaluaciones).
    // jugador: lectura de sus propias evaluaciones.
    // tutor: lectura de evaluaciones de sus hijos.

    match /evaluations/{evaluationId} {
      allow read: if isAuthenticated() && belongsToClub() && (
        isAdmin() ||
        hasRole('entrenador') ||
        (hasRole('jugador') && isOwnPlayer(resource.data.playerId)) ||
        (hasRole('tutor') && isChildPlayer(resource.data.playerId))
      );

      allow create: if isAuthenticated() && incomingBelongsToClub() && (
        isAdmin() ||
        hasRole('entrenador')
      );

      allow update: if isAuthenticated() && belongsToClub() && incomingBelongsToClub() && (
        isAdmin() ||
        hasRole('entrenador')
      );

      allow delete: if isAdmin() && belongsToClub();
    }

    // ─── Coach Salary Configs Collection ────────────────────────────────
    // Solo directores pueden gestionar configuraciones de salario.

    match /coachSalaryConfigs/{configId} {
      allow read: if isAdmin() && belongsToClub();
      allow create: if hasRole('director') && incomingBelongsToClub();
      allow update: if hasRole('director') && belongsToClub() && incomingBelongsToClub();
      allow delete: if hasRole('director') && belongsToClub();
    }
  }
}
