rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────

    // Returns the authenticated user's document from the users collection.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Returns the role of the authenticated user.
    function getRole() {
      return getUserData().get('role', 'none');
    }

    // Returns the clubId of the authenticated user.
    function getClubId() {
      return getUserData().get('clubId', 'none');
    }

    // True when the user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // True when the authenticated user holds the given role.
    function hasRole(role) {
      return isAuthenticated() && getRole() == role;
    }

    // True when the authenticated user holds any of the given roles.
    function hasAnyRole(roles) {
      return isAuthenticated() && getRole() in roles;
    }

    // True when the authenticated user is a director or coordinador.
    function isAdmin() {
      return isAuthenticated() && (getRole() == 'director' || getRole() == 'coordinador');
    }

    // True when the resource document belongs to the same club as the user.
    function belongsToClub() {
      return isAuthenticated() && (resource.data.clubId == getClubId() || resource.data.clubId == null);
    }

    // True when the incoming document belongs to the same club as the user.
    function incomingBelongsToClub() {
      return isAuthenticated() && (request.resource.data.clubId == getClubId() || request.resource.data.clubId == null);
    }

    // True when the authenticated user's linkedPlayerId matches the given id.
    function isOwnPlayer(playerId) {
      return getUserData().linkedPlayerId == playerId;
    }

    // True when the given playerId is among the tutor's linked children.
    function isChildPlayer(playerId) {
      return playerId in getUserData().linkedPlayerIds;
    }

    // ─── Users Collection ───────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (isAdmin() && resource.data.clubId == getClubId())
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        (isAdmin() && request.resource.data.clubId == getClubId())
      );

      allow update: if isAdmin() && resource.data.clubId == getClubId() && incomingBelongsToClub();
      allow delete: if isAdmin() && resource.data.clubId == getClubId();
    }
    
    // ─── Clubs Collection ───────────────────────────────────────────────
    
    match /clubs/{clubId} {
      allow read: if isAuthenticated() && clubId == getClubId();
      
      // Allow update for admins. Counter increments happen here.
      allow create, update: if isAdmin();
    }

    // ─── Players Collection ─────────────────────────────────────────────

    match /players/{playerId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub()) && (
        isAdmin() ||
        hasRole('entrenador') ||
        (hasRole('jugador') && isOwnPlayer(playerId)) ||
        (hasRole('tutor') && isChildPlayer(playerId))
      );

      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Groups Collection ──────────────────────────────────────────────

    match /groups/{groupId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub());
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Enrollments Collection ─────────────────────────────────────────

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub());
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Attendance Collection ──────────────────────────────────────────

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub());
      allow create: if isAuthenticated() && (isAdmin() || hasRole('entrenador'));
      allow update: if isAuthenticated() && (isAdmin() || hasRole('entrenador'));
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Payments Collection ────────────────────────────────────────────

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub()) && (
        isAdmin() ||
        (hasRole('jugador') && isOwnPlayer(resource.data.playerId)) ||
        (hasRole('tutor') && isChildPlayer(resource.data.playerId))
      );

      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Coaches Collection ─────────────────────────────────────────────

    match /coaches/{coachId} {
      allow read: if isAdmin() && (belongsToClub() || resource.data.clubId == null) ||
        (hasRole('entrenador') && belongsToClub() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Settings Collection ────────────────────────────────────────────

    match /settings/{settingId} {
      allow read: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Tariffs Collection ─────────────────────────────────────────────

    match /tariffs/{tariffId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub());
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Courts Collection ──────────────────────────────────────────────

    match /courts/{courtId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub());
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Activities Collection ──────────────────────────────────────────

    match /activities/{activityId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub());
      allow create: if isAuthenticated() && (isAdmin() || hasRole('entrenador'));
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Invitations Collection ─────────────────────────────────────────

    match /invitations/{invitationId} {
      allow read: if true;
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if (
        (isAdmin() && (belongsToClub() || resource.data.clubId == null)) ||
        (request.resource.data.status == 'aceptada' &&
         request.resource.data.email == request.auth.token.email)
      );
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Events Collection ──────────────────────────────────────────────

    match /events/{eventId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub());
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Private Lessons Collection ─────────────────────────────────────

    match /privateLessons/{lessonId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub()) && (
        isAdmin() ||
        (hasRole('entrenador') && resource.data.coachId == request.auth.uid)
      );
      allow create: if isAuthenticated() && (isAdmin() || hasRole('entrenador'));
      allow update: if isAuthenticated() && (isAdmin() || hasRole('entrenador'));
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null) ||
        (hasRole('entrenador') && belongsToClub() && resource.data.coachId == request.auth.uid);
    }

    // ─── Private Lesson Payments Collection ─────────────────────────────

    match /privateLessonPayments/{paymentId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub()) && (
        isAdmin() ||
        hasRole('entrenador') ||
        (hasRole('jugador') && isOwnPlayer(resource.data.playerId)) ||
        (hasRole('tutor') && isChildPlayer(resource.data.playerId))
      );
      allow create: if isAuthenticated() && (isAdmin() || hasRole('entrenador'));
      allow update: if isAuthenticated() && (isAdmin() || hasRole('entrenador'));
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Event Payments Collection ──────────────────────────────────────

    match /eventPayments/{paymentId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub()) && (
        isAdmin() ||
        hasRole('entrenador') ||
        (hasRole('jugador') && isOwnPlayer(resource.data.playerId)) ||
        (hasRole('tutor') && isChildPlayer(resource.data.playerId))
      );
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Invoices Collection ────────────────────────────────────────────

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub()) && (
        isAdmin() ||
        (hasRole('jugador') && isOwnPlayer(resource.data.playerId)) ||
        (hasRole('tutor') && isChildPlayer(resource.data.playerId))
      );

      // Relaxed rules for invoice creation to avoid transaction issues
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Evaluations Collection ─────────────────────────────────────────

    match /evaluations/{evaluationId} {
      allow read: if isAuthenticated() && (isAdmin() || belongsToClub()) && (
        isAdmin() ||
        hasRole('entrenador') ||
        (hasRole('jugador') && isOwnPlayer(resource.data.playerId)) ||
        (hasRole('tutor') && isChildPlayer(resource.data.playerId))
      );

      allow create: if isAuthenticated() && (isAdmin() || hasRole('entrenador'));
      allow update: if isAuthenticated() && (isAdmin() || hasRole('entrenador'));
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Coach Salary Configs Collection ────────────────────────────────

    match /coachSalaryConfigs/{configId} {
      allow read: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Receipt Generations Collection ─────────────────────────────────

    match /receiptGenerations/{generationId} {
      allow read: if isAdmin() && (resource == null || belongsToClub() || resource.data.clubId == null);
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Club Transactions Collection ───────────────────────────────────

    match /clubTransactions/{transactionId} {
      allow read: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow create: if isAdmin() && (incomingBelongsToClub() || request.resource.data.clubId == null);
      allow update: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
      allow delete: if isAdmin() && (belongsToClub() || resource.data.clubId == null);
    }

    // ─── Methodology Parameters Collection ──────────────────────────────
    match /methodology_parameters/{paramId} {
      allow read: if isAuthenticated() && (
        isAdmin() || hasRole('entrenador')
      );
      allow create, update, delete: if isAdmin();
    }
    
    // ─── Global Planning Module ─────────────────────────────────────────
    match /training_templates/{templateId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /group_plan_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /group_session_records/{recordId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isAdmin() || hasRole('entrenador'));
    }

    // Settings for Holidays
    match /settings_holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
